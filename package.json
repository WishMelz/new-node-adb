{
  "name": "adb-desk",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "fastify": "5.12.7",
    "follow-redirects": "1.16.2",
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @adb/api\" \"npm run dev -w @adb/web\"",
    "build": "npm run build -w @adb/api && npm run build -w @adb/web",
    "test": "npm run test -w @adb/api && npm run test -w @adb/web",
    "test:docker": "node scripts/docker-smoke.mjs",
    "adb:identity": "npm run build -w @adb/api && node apps/api/dist/adb-identity-cli.js",
    "start": "npm run start -w @adb/api",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/test-utils": "2.4.6",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
